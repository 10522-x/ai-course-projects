page { height:100%; background:#f7f8fa; color:#25303b; }.mode-page { height:100vh; min-height:100vh; padding-top:env(safe-area-inset-top); padding-bottom:env(safe-area-inset-bottom); box-sizing:border-box; background:linear-gradient(#f3f8fc,#fafafa); }
.mode-head { height:90rpx; display:flex; align-items:center; padding:0 34rpx; font-size:32rpx; font-weight:700; position:relative; }.back { font-size:54rpx; font-weight:300; line-height:1; width:70rpx; }.mode-title { position:absolute; left:50%; transform:translateX(-50%); white-space:nowrap; }.mode-content { padding:38rpx 24rpx; }.intro-title { color:#435c78; font-size:27rpx; font-weight:700; }.intro-copy { color:#8c9aae; font-size:24rpx; margin:8rpx 0 26rpx; }
.mode-card { min-height:132rpx; border:2rpx solid #e5eaef; border-radius:24rpx; background:rgba(255,255,255,.8); margin-bottom:16rpx; padding:20rpx 24rpx; display:flex; align-items:center; }.mode-selected { border-color:#20a896; box-shadow:0 2rpx 0 #20a896 inset; }.cat-avatar { width:92rpx; height:92rpx; border-radius:50%; overflow:hidden; background:#eef2f4; margin-right:22rpx; flex:none; }.cat-avatar image { width:100%; height:100%; display:block; }
.mode-text { display:flex; flex-direction:column; gap:7rpx; }.mode-name { font-size:28rpx; font-weight:700; }.mode-desc { font-size:23rpx; color:#94a0af; }.mode-check { margin-left:auto; color:#18a390; font-size:36rpx; }
