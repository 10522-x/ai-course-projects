page { height:100%; background:#f7f8fa; color:#242a32; }.background-page { height:100vh; min-height:100vh; padding-top:env(safe-area-inset-top); padding-bottom:env(safe-area-inset-bottom); box-sizing:border-box; background:linear-gradient(#f5f8fb,#fafafa); }
.bg-head { height:90rpx; display:flex; align-items:center; justify-content:space-between; padding:0 34rpx; font-size:32rpx; font-weight:700; }.back { font-size:54rpx; font-weight:300; line-height:1; width:70rpx; }.head-space { width:70rpx; }
.background-content { padding:28rpx 24rpx; }.choices { display:flex; justify-content:space-between; }.choice { width:22%; text-align:center; color:#697482; font-size:23rpx; }.choice-preview { height:110rpx; border-radius:20rpx; margin-bottom:12rpx; display:flex; align-items:center; justify-content:center; font-size:46rpx; position:relative; border:3rpx solid transparent; }
.choice-preview.bg-wood { background:repeating-linear-gradient(90deg,#e8dfcf 0,#e8dfcf 28rpx,#dcd2c1 31rpx,#f0e8dc 58rpx); }.bg-plain { background:#f5f6f2; }.bg-sky { background:#e4f2f8; }.bg-grass { background:#e6efdf; }.choice-selected { border-color:#2da99d; }.check { position:absolute; right:-12rpx; bottom:-12rpx; width:38rpx; height:38rpx; border-radius:50%; background:#2da99d; color:white; font-size:24rpx; display:flex; align-items:center; justify-content:center; }
.demo { height:530rpx; border-radius:24rpx; margin-top:40rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; overflow:hidden; }.demo-pounce { width:100%; height:390rpx; display:block; }.demo-copy { margin-top:18rpx; text-align:center; line-height:1.8; font-weight:700; font-size:26rpx; }
.again { margin-top:34rpx; background:#2da99d; color:#fff; border-radius:44rpx; font-size:28rpx; height:82rpx; line-height:82rpx; }.again::after { border:0; }
