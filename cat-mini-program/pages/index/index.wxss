page { height: 100%; background: #eff3f6; }
.page { height: 100vh; min-height: 100vh; padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; color: #24282d; display: flex; flex-direction: column; overflow: hidden; transition: background .35s ease; }
.bg-plain { background: #f5f6f2; }.bg-sky { background: #e8f4fa; }.bg-grass { background: #e9f0e2; }
.bg-wood { background: repeating-linear-gradient(90deg,#e8dfcf 0,#e8dfcf 72rpx,#dcd2c1 76rpx,#f0e8dc 142rpx); }
.nav-bar { height: 82rpx; padding: 0 28rpx 0 34rpx; display: flex; align-items: center; position: relative; }
.settings-entry { width: 64rpx; height: 56rpx; display: flex; align-items: center; justify-content: flex-start; color: #5b6570; opacity: .82; }
.settings-entry-active { opacity: .48; }.settings-icon { font-size: 34rpx; line-height: 1; }
.nav-title { position: absolute; left: 50%; transform: translateX(-50%); font-size: 30rpx; font-weight: 700; white-space: nowrap; }
.scene { flex: 1; min-height: 0; position: relative; margin: 0 16rpx; overflow: hidden; }
.cloud { position: absolute; border-radius: 50%; background: rgba(255,255,255,.5); filter: blur(3rpx); }.cloud-one { width: 260rpx; height: 170rpx; left: -130rpx; top: 7%; }.cloud-two { width: 310rpx; height: 220rpx; right: -150rpx; bottom: 7%; }
.paw-print { position: absolute; width: 56rpx; height: 55rpx; opacity: .28; transform: rotate(-24deg); }.paw-one { left: 20%; top: 27%; }.paw-two { right: 20%; top: 67%; transform: rotate(18deg); }
.paw-print i { position: absolute; width: 13rpx; height: 19rpx; border-radius: 60% 60% 40% 40%; background: currentColor; }.paw-print i:nth-child(1) { left: 3rpx; top: 15rpx; }.paw-print i:nth-child(2) { left: 19rpx; top: 2rpx; }.paw-print i:nth-child(3) { right: 19rpx; top: 2rpx; }.paw-print i:nth-child(4) { right: 3rpx; top: 15rpx; }.paw-print b { position: absolute; left: 17rpx; bottom: 4rpx; width: 24rpx; height: 23rpx; border-radius: 55% 55% 45% 45%; background: currentColor; }
.toy { position: absolute; width: 220rpx; height: 220rpx; transform: translate(-50%,-50%) rotate(var(--toy-rotation)); z-index: 2; }
.toy-escape { transform: translate(-50%,-50%) scale(1.2) rotate(var(--toy-rotation)); }.toy-image { position:absolute; left:0; top:0; width:100%; height:100%; z-index:1; }
.toy-shadow { position:absolute; left:50%; top:67%; width:105rpx; height:22rpx; transform:translateX(-50%); border-radius:50%; background:rgba(64,76,87,.12); filter:blur(8rpx); }
.ball-art { width: 102rpx; height: 102rpx; border-radius: 50%; background: radial-gradient(circle at 32% 26%,#ffb1a7 0,#f56f73 47%,#e95662 100%); box-shadow: inset -8rpx -8rpx 0 rgba(182,51,66,.12), 0 15rpx 20rpx rgba(203,77,79,.16); }
.yarn { position: absolute; display: block; border: 4rpx solid rgba(197,49,69,.26); border-left-color: transparent; border-right-color: transparent; border-radius: 50%; transform: rotate(-28deg); }.yarn-one { width: 75rpx; height: 35rpx; left: 12rpx; top: 30rpx; }.yarn-two { width: 64rpx; height: 36rpx; left: 20rpx; top: 48rpx; transform: rotate(22deg); }.yarn-three { width: 46rpx; height: 90rpx; left: 35rpx; top: 7rpx; transform: rotate(67deg); }
.ball-tail { position: absolute; width: 63rpx; height: 34rpx; border-bottom: 6rpx solid #e95362; border-radius: 0 0 60% 50%; right: -52rpx; bottom: -5rpx; transform: rotate(16deg); }
.mouse-art { width: 126rpx; height: 85rpx; border-radius: 48% 55% 48% 43%; background: #87909e; box-shadow: inset -10rpx -8rpx 0 rgba(72,79,91,.13), 0 14rpx 18rpx rgba(89,97,107,.18); }.mouse-ear { position: absolute; width: 34rpx; height: 34rpx; border-radius: 50%; background: #9da6b3; border: 7rpx solid #737c89; top: -20rpx; }.ear-one { left: 18rpx; }.ear-two { left: 48rpx; }.mouse-eye { position: absolute; width: 9rpx; height: 9rpx; background:#27313c; border-radius:50%; left: 93rpx; top: 26rpx; }.mouse-nose { position:absolute; width:10rpx; height:8rpx; border-radius:50%; background:#39424e; right:-5rpx; top:42rpx; }.mouse-tail { position: absolute; width: 80rpx; height: 42rpx; border-bottom: 5rpx solid #dc9f9d; border-radius: 0 0 70% 60%; left: -59rpx; top: 55rpx; transform: rotate(-20deg); }
.bird-art { width: 118rpx; height: 82rpx; border-radius: 66% 60% 50% 58%; background: #f6ca54; box-shadow: inset -9rpx -6rpx 0 rgba(211,152,41,.13), 0 14rpx 18rpx rgba(125,125,92,.14); }.bird-wing { position: absolute; width: 65rpx; height: 48rpx; background: #78aee3; border-radius: 100% 8% 100% 8%; top: 23rpx; }.wing-one { left: -42rpx; transform: rotate(-28deg); }.wing-two { right: -28rpx; transform: scaleX(-1) rotate(-28deg); }.bird-beak { position:absolute; right:-22rpx; top:31rpx; width:0; height:0; border-top:13rpx solid transparent; border-bottom:13rpx solid transparent; border-left:25rpx solid #e59b35; }.bird-tail { position:absolute; left:-17rpx; bottom:3rpx; border-left:26rpx solid transparent; border-right:26rpx solid transparent; border-bottom:36rpx solid #7da9e1; transform:rotate(-18deg); }
.motion-line { position: absolute; border-top: 3rpx solid rgba(105,163,190,.2); border-radius: 50%; width: 100rpx; height: 42rpx; }.line-one { left: 24%; top: 45%; transform: rotate(-16deg); }.line-two { right: 24%; top: 49%; transform: rotate(160deg); }
.toy-dock { margin: 0 18rpx 20rpx; min-height: 168rpx; border-radius: 30rpx; background: rgba(255,255,255,.9); display: flex; justify-content: space-around; align-items: center; box-shadow: 0 8rpx 30rpx rgba(71,78,87,.08); }
.toy-option { width: 31%; height: 130rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: #6d7378; font-size: 22rpx; }.option-icon { width: 76rpx; height: 76rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f3f4f5; position: relative; overflow: hidden; }.option-image { width: 92rpx; height: 92rpx; }
.selected { color: #25282d; font-weight: 700; }.selected .option-icon { box-shadow: 0 0 0 4rpx currentColor; }.selected-coral { color: #ef7778; }.selected-blue { color: #4f9ae8; }.selected-yellow { color: #e6b837; }
.mini-ball { width: 39rpx; height: 39rpx; border-radius: 50%; background: #f26d73; box-shadow: inset -5rpx -4rpx 0 rgba(173,44,58,.14); }.mini-mouse { width: 42rpx; height: 30rpx; border-radius: 50%; background:#87909e; position:relative; }.mini-mouse:before,.mini-mouse:after { content:""; position:absolute; top:-8rpx; width:13rpx; height:13rpx; background:#9da6b3; border-radius:50%; }.mini-mouse:before { left:6rpx; }.mini-mouse:after { left:18rpx; }.mini-bird { width:42rpx; height:30rpx; border-radius:60%; background:#f6ca54; position:relative; }.mini-bird:before { content:""; position:absolute; left:-15rpx; top:6rpx; border-top:9rpx solid transparent; border-bottom:9rpx solid transparent; border-right:20rpx solid #7da9e1; }
.cat-vision .toy { transform: translate(-50%,-50%) rotate(var(--toy-rotation)) scale(1.16); }.cat-vision .scene { filter: contrast(1.08); }
