page { background:#f7f8fa; height:100%; color:#242a32; }.settings-page { height:100vh; min-height:100vh; padding-top:env(safe-area-inset-top); padding-bottom:env(safe-area-inset-bottom); box-sizing:border-box; display:flex; flex-direction:column; overflow:hidden; background:linear-gradient(#f5f8fb,#fafafa); }
.settings-head { flex:none; height:90rpx; display:flex; align-items:center; justify-content:space-between; padding:0 34rpx; font-size:34rpx; font-weight:700; }.back { font-size:54rpx; font-weight:300; line-height:1; width:70rpx; }.head-space { width:70rpx; }
.settings-scroll { flex:1; height:0; min-height:0; box-sizing:border-box; padding:20rpx 22rpx 60rpx; }.section-title { color:#52627a; font-size:24rpx; font-weight:700; margin:22rpx 14rpx 14rpx; }
.panel { background:rgba(255,255,255,.83); border-radius:24rpx; padding:0 24rpx; box-shadow:0 5rpx 24rpx rgba(91,104,116,.04); }.row { min-height:104rpx; display:flex; align-items:center; justify-content:space-between; font-size:27rpx; }.speed-row { min-height:86rpx; }
.row-label { display:flex; align-items:center; gap:22rpx; }.row-icon { font-size:36rpx; width:30rpx; text-align:center; color:#233146; }.value,.row-right,.vision-state { color:#8c96a5; font-size:24rpx; }.vision-state { color:#2b9e92; font-weight:600; }.row-right { display:flex; gap:18rpx; align-items:center; }.chevron { font-size:42rpx; color:#a5afbb; line-height:1; }
slider { margin:0 12rpx 16rpx; }.divider { height:1rpx; background:#eef0f2; }
.tutorial-row { min-height:104rpx; display:flex; align-items:center; justify-content:space-between; font-size:27rpx; }
