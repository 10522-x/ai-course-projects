page { height:100%; background:#fafafa; color:#27303a; }.tutorial-page { height:100vh; min-height:100vh; padding-top:env(safe-area-inset-top); padding-bottom:env(safe-area-inset-bottom); box-sizing:border-box; background:#fcfcfb; }.tutorial-head { height:90rpx; display:flex; align-items:center; justify-content:space-between; padding:0 34rpx; font-size:32rpx; font-weight:700; }.back { font-size:54rpx; font-weight:300; line-height:1; width:70rpx; }.head-space { width:70rpx; }
.tutorial-content { padding:28rpx 24rpx; display:flex; flex-direction:column; align-items:center; }.demo-card { width:100%; height:530rpx; border-radius:24rpx; background:#f3f5f3; position:relative; overflow:hidden; }.tutorial-art { width:100%; height:100%; display:block; }.tutorial-copy { margin-top:42rpx; font-size:27rpx; line-height:1.75; font-weight:700; text-align:center; }.dots { display:flex; gap:13rpx; margin:34rpx 0; }.dots i { width:14rpx; height:14rpx; border-radius:50%; background:#e0e4e7; }.dots i.active { background:#29a99c; }.tutorial-content button { width:88%; height:78rpx; line-height:78rpx; border:0; border-radius:40rpx; background:#2da99d; color:#fff; font-size:27rpx; }
